---
import AboutMe from "./AboutMe.astro";

interface Props {
  creationYear?: number;
}

const { creationYear } = Astro.props as Props;
---

<footer class="flex flex-col gap-12">
  <p>Hi, I'm Travis.</p>

  <AboutMe />

  <p>
    &copy; {creationYear ?? new Date().getFullYear()} Travis Horn, <a
      class="underline"
      href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a
    >
  </p>
</footer>
