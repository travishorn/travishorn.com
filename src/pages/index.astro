---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import AboutMe from "../components/AboutMe.astro";
import PostCard from "../components/PostCard.astro";
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import homeCover from "../blog/images/travis-horn-og.webp";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");

const optimizedHomeCover = await getImage({ src: homeCover });
const pageOgImage = optimizedHomeCover.src;

const latestPosts = posts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
  )
  .slice(0, 3);
---

<Layout ogImage={pageOgImage}>
  <main class="flex flex-col gap-12">
    <AboutMe />

    <p>Here are some of the latest articles I've written:</p>

    <div class="flex flex-col gap-6">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>

    <a class="underline" href="/blog/">See more articles</a>
  </main>
</Layout>
