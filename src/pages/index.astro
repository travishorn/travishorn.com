---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import AboutMe from "../components/AboutMe.astro";
import PostCard from "../components/PostCard.astro";
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import homeCover from "../blog/images/travis-horn-og.webp";
import {
  comparePublishedBlogPostsByDateDesc,
  isPublishedBlogPost,
} from "../utils/blog";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");

const optimizedHomeCover = await getImage({ src: homeCover });
const pageOgImage = optimizedHomeCover.src;

// Get all published posts sorted by date
const allPosts = posts
  .filter(isPublishedBlogPost)
  .sort(comparePublishedBlogPostsByDateDesc);

// Group into featured and latest (non-featured) posts
const featuredPosts = allPosts.filter((post) => post.data.featured);
const latestPosts = allPosts.filter((post) => !post.data.featured);

// If there are less than 3 featured posts, calculate how many latest posts are
// needed to fill to 3 posts
const latestNeeded = Math.max(0, 3 - featuredPosts.length);

// Combine. Featured posts first, followed by latest posts to fill to 3 total
const displayPosts = [...featuredPosts, ...latestPosts.slice(0, latestNeeded)];
---

<Layout ogImage={pageOgImage}>
  <main class="flex flex-col gap-12">
    <AboutMe />

    <p>Here are some of the latest articles I've written:</p>

    <div class="flex flex-col gap-6">
      {displayPosts.map((post) => <PostCard post={post} />)}
    </div>

    <a class="underline" href="/blog/">See more articles</a>
  </main>
</Layout>
