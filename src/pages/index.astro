---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import AboutMe from "../components/AboutMe.astro";
import PostCard from "../components/PostCard.astro";
import type { CollectionEntry } from "astro:content";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");

const latestPosts = posts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
  )
  .slice(0, 3);
---

<Layout>
  <main class="flex flex-col gap-12">
    <AboutMe />

    <p>Here are some of the latest articles I've written:</p>

    <div class="flex flex-col gap-6">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>

    <a class="underline" href="/blog/">See more articles</a>
  </main>
</Layout>
