---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import homeCover from "../blog/images/travis-horn-og.webp";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");

const optimizedHomeCover = await getImage({ src: homeCover });
const pageOgImage = optimizedHomeCover.src;

const sortedPosts = posts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
  );

const pageTitle = `Articles on Data Science & Web Dev - Travis Horn's Blog`;
const pageDescription =
  "Explore a collection of technical articles on web development, programming, and data science. Read tutorials, code deep-dives, and industry insights.";
---

<Layout title={pageTitle} description={pageDescription} ogImage={pageOgImage}>
  <main class="flex flex-col gap-12">
    <div class="flex flex-col gap-6">
      {sortedPosts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
</Layout>
